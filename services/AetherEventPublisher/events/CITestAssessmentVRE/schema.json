{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CI Test Assessment VRE Event",
  "description": "Published when a VRE (Vehicle Readiness Engineer) assessment is recorded.",
  "type": "object",
  "required": [
    "source",
    "detail-type",
    "detail",
    "time",
    "build_id"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "JSON Schema version",
      "const": "0"
    },
    "id": {
      "type": "string",
      "description": "Unique event identifier (UUID v4)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "build_id": {
      "type": "string",
      "description": "Build identifier in the format YYYYMMDD_N (e.g. 20261031_55)",
      "pattern": "^[0-9]{8}_[0-9]{1,3}$"
    },
    "source": {
      "type": "string",
      "description": "Source of the event",
      "const": "com.aether.app"
    },
    "detail-type": {
      "type": "string",
      "const": "citest.assessment.vre",
      "description": "Type of event"
    },
    "detail": {
      "type": "object",
      "description": "CI test assessment payload",
      "required": [
        "created_by",
        "result",
        "description"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "description": "Identifier for the user creating the assessment",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "description": "Assessment result",
          "enum": [
            "PENDING",
            "REVIEW",
            "PASS",
            "FAIL",
            "INCOMPLETE",
            "CANCELED"
          ]
        },
        "description": {
          "type": "string",
          "description": "Human-readable assessment description",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the event occurred"
    },
    "region": {
      "type": "string",
      "description": "AWS region where the event originated",
      "pattern": "^[a-z]{2}-[a-z]+-\\d$"
    },
    "account": {
      "type": "string",
      "description": "AWS account ID that published the event",
      "pattern": "^\\d{12}$"
    },
    "resources": {
      "type": "array",
      "description": "ARNs of resources associated with this event",
      "items": {
        "type": "string"
      }
    }
  }
}